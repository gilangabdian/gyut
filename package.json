{
  "name": "gyut-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter gyuttt build && pnpm --filter playground build",
    "build:core": "pnpm --filter gyuttt build",
    "build:playground": "pnpm --filter playground build",
    "publish:core": "pnpm build:core && pnpm --filter gyuttt publish --access public",
    "test": "pnpm --filter gyuttt test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
