{
  "name": "gyut",
  "version": "0.1.0",
  "description": "Glitch your text with GYUT - lightweight, framework-agnostic animated text glitch library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "glitch",
    "text-glitch",
    "glitch-effect"
  ],
  "author": "Abdian <https://github.com/gilangabdian>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilangabdian/gyut.git"
  },
  "bugs": {
    "url": "https://github.com/gilangabdian/gyut/issues"
  },
  "homepage": "https://github.com/gilangabdian/gyut#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
